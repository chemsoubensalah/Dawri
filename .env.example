# ——— قاعدة البيانات (Supabase) ———
# Supabase ← Project Settings ← Database ← Connection string ← "Transaction pooler" (المنفذ 6543)
# بدونها: يعمل التطبيق محلّياً بقاعدة مضمَّنة (.pglite) ومحلّ تجريبي /s/demo
DATABASE_URL=

# سرّ توقيع جلسات السكرتيرة ورموز التحقّق (32 حرفاً على الأقلّ). أنشئه بـ: openssl rand -base64 32
SESSION_SECRET=

# رابط الموقع (يُستعمل في رموز QR). مثال: https://dawri.vercel.app
NEXT_PUBLIC_APP_URL=

# ——— رموز التحقّق بالرسائل القصيرة ———
# console | twilio | webhook
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# لأيّ بوّابة رسائل: يُرسَل POST بـ {"to": "+213…", "text": "…"}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# off = بلا رمز تحقّق (للتجربة الأولى فقط — يُضعف الحماية من التلاعب)
PHONE_VERIFICATION=
# 1 = يرسل أيضاً رسالة SMS لـ«تعال الآن» و«دورك الآن» (لها كلفة)
SMS_NOTIFICATIONS=
# 1 = يُظهر رمز التحقّق على الشاشة (للعرض والتجربة فقط! لا تفعّله مع زبائن حقيقيين)
DAWRI_DEMO=

# ——— تنبيهات الهاتف (Web Push) ———
# أنشئ المفاتيح بـ: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ——— متفرّقات ———
# Vercel Cron يرسله تلقائياً في ترويسة Authorization
CRON_SECRET=
# إن وُضع: لا يستطيع إنشاء محلّ إلّا من يعرف هذا الرمز
SIGNUP_CODE=
