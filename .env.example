# ═══════════ الأساسيات (إلزامية في الإنتاج) ═══════════
# Supabase ← Connect ← Direct (Connection string) ← Transaction pooler (المنفذ 6543)
# بدونها: يعمل التطبيق محلّياً بقاعدة مضمَّنة (.pglite) ومحلّ تجريبي /s/demo
DATABASE_URL=
# سرّ توقيع الجلسات (32 حرفاً على الأقلّ). مثال: openssl rand -hex 32
SESSION_SECRET=
# رابط الموقع الدائم — يُستعمل في رموز QR وفي روابط رسائل واتساب
NEXT_PUBLIC_APP_URL=https://dawri-fawn.vercel.app

# ═══════════ المهامّ والإدارة ═══════════
# Vercel Cron يرسله تلقائياً (تنظيف يومي)
CRON_SECRET=
# كلمة سرّ لوحة المؤسّس /admin (12 حرفاً على الأقلّ)
ADMIN_SECRET=
# إن وُضع: لا يُنشئ عيادة إلّا من يعرف هذا الرمز
SIGNUP_CODE=
# الأسعار بالدينار (أوّل شهر مجّاني، بلا عمولة)
# خطّة الطبيب الواحد (Cabinet): شهري / سنوي
NEXT_PUBLIC_PRICE_DZD=1000
NEXT_PUBLIC_PRICE_YEAR_DZD=10000
# خطّة العيادة متعدّدة الأطبّاء (Clinique، حتى 8 أطبّاء باشتراك واحد): شهري / سنوي
NEXT_PUBLIC_CLINIC_PRICE_DZD=2000
NEXT_PUBLIC_CLINIC_PRICE_YEAR_DZD=20000

# ═══════════ واتساب (موصى به: تحقّق مجّاني + تنبيهات) ═══════════
# من Meta: App Dashboard ← WhatsApp ← API Setup + System User token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# أيّ نصّ عشوائي تختاره، وتضعه أيضاً في إعدادات Webhook عند Meta
WHATSAPP_VERIFY_TOKEN=
# رقم «دوري» على واتساب، أرقام فقط بالصيغة الدولية (مثل 213550123456)
WHATSAPP_NUMBER=
WHATSAPP_GRAPH_VERSION=v26.0
# اختياري: اسم قالب «utility» معتمد لإرسال «دورك الآن» خارج نافذة الـ24 ساعة
WHATSAPP_TEMPLATE_TURN=

# ═══════════ رسائل SMS (بديل/احتياط) ═══════════
# console | twilio | webhook
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# لأيّ بوّابة رسائل: يُرسَل POST بـ {"to": "+213…", "text": "…"}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# off = بلا تحقّق من الهاتف (لتجربة أولى فقط)
PHONE_VERIFICATION=
# called = «دورك الآن» برسالة SMS لمن لا يملك واتساب ، 1 = «تعال الآن» + «دورك الآن»
SMS_NOTIFICATIONS=
# 1 = يُظهر رمز التحقّق على الشاشة (للتجربة فقط! لا تفعّله مع مرضى حقيقيّين)
DAWRI_DEMO=

# ═══════════ تنبيهات الهاتف (Web Push) ═══════════
# أنشئها بـ: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ═══════════ الدفع ═══════════
# Chargily Pay (البطاقة الذهبية و CIB) — المفتاح السرّي test_sk_… للتجربة ثمّ مفتاح live
CHARGILY_SECRET_KEY=
# تحويل يدوي (بريدي موب / CCP) يظهر في صفحة الاشتراك
BILLING_HOLDER=
BILLING_RIP=
BILLING_CCP=
# رقم واتساب لاستقبال وصولات التحويل (أرقام فقط)
SUPPORT_WHATSAPP=

# البريد الإلكتروني — لاستعادة الرمز السرّي فقط (رابط إعادة التعيين)
# brevo: حساب مجّاني على brevo.com (300 رسالة/يوم)، EMAIL_FROM = بريد مُوثَّق عندهم (يكفي Gmail)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Dawri — دوري
# أو: EMAIL_PROVIDER=resend + RESEND_API_KEY (يحتاج نطاقاً مُوثَّقاً)
